# Entity: bmi

main: kit: entity: bmi: {

  alias: field: {}

  fields: [
    {
      name: "Category"
      req: true
      short: "Health category based on BMI"
      type: "`$STRING`"
    }
    {
      format: "float"
      name: "bmi"
      req: true
      short: "Calculated BMI (trimmed to 3 decimal points)"
      type: "`$NUMBER`"
    }
    {
      format: "float"
      name: "height"
      req: true
      short: "Provided height in meters"
      type: "`$NUMBER`"
    }
    {
      name: "id"
      req: false
      type: "`$STRING`"
    }
    {
      format: "float"
      name: "weight"
      req: true
      short: "Provided weight in kilograms"
      type: "`$NUMBER`"
    }
  ]

  id: {
    field: "id"
    from: {
      height: "height"
      weight: "weight"
    }
    name: "id"
    parts: [
      "weight"
      "height"
    ]
    sep: "/"
  }

  name: "bmi"
  op: {
    load: {
      name: "load"
      points: [
        {
          args: {
            params: [
              {
                example: 1.75
                kind: "param"
                name: "height"
                orig: "height"
                reqd: true
                type: "`$NUMBER`"
              }
              {
                example: 87.9
                kind: "param"
                name: "weight"
                orig: "weight"
                reqd: true
                type: "`$NUMBER`"
              }
            ]
          }
          method: "GET"
          orig: "/api/bmi/{weight}/{height}"
          segments: [
            {
              lit: "api"
            }
            {
              lit: "bmi"
            }
            {
              var: "weight"
            }
            {
              var: "height"
            }
          ]
          select: {
            exist: [
              "height"
              "weight"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }

  relations: {
    ancestors: [
      [
        "bmi"
      ]
    ]
  }



}
